{
  "buildCommand": "node scripts/build-api.mjs && ./packages/api/node_modules/.bin/tsx scripts/migrate.ts && cd packages/web && npx vite build",
  "outputDirectory": "packages/web/dist",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": "vite",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "api/handler.mjs,db/drizzle/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/maintenance/cleanup-tokens", "schedule": "0 3 * * *" }
  ]
}
