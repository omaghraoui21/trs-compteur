# ─── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trs_compteur
JWT_SECRET=change-me-in-production
PORT=3001

# ─── Recommended in production ─────────────────────────────
# Node environment: "production" enables strict CORS + JWT_SECRET boot check.
NODE_ENV=development
# Frontend origin allowed by CORS. If unset in production, CORS is same-origin
# only (never "*"). Set this only when the SPA is served from a different host.
ALLOWED_ORIGIN=
# Plant timezone — the local calendar day used to date production shifts.
# Critical for night shifts: an unset/UTC value misdates them. Default Europe/Paris.
APP_TIMEZONE=Europe/Paris

# ─── Optional ──────────────────────────────────────────────
# Secret(s) guarding the maintenance/cron endpoints (DB backup trigger, etc.).
# On Vercel, CRON_SECRET is injected automatically by the cron system.
CRON_SECRET=
MAINTENANCE_SECRET=
# Override paths (set automatically in Docker/Vercel; leave blank locally).
MIGRATIONS_DIR=
STATIC_ROOT=
# Sentry error monitoring (optional — leave blank to disable in local dev).
SENTRY_DSN=
VITE_SENTRY_DSN=
