{
  "name": "trs-compteur",
  "private": true,
  "description": "TRS/OEE Compteur Continu — Blistereuse & Géluleuse",
  "scripts": {
    "dev:api": "pnpm --filter @trs/api dev",
    "dev:web": "pnpm --filter @trs/web dev",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter @trs/db push",
    "db:generate": "pnpm --filter @trs/db generate",
    "db:migrate": "pnpm --filter @trs/db migrate",
    "db:seed": "pnpm --filter @trs/api seed",
    "db:reset": "./packages/api/node_modules/.bin/tsx scripts/reset-operational-data.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "^0.28.0"
  }
}
